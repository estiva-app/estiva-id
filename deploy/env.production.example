# /opt/estiva-id/.env on the server. Never committed anywhere.
#
# DATABASE_URL is supplied by docker-compose.yml, not here.

NODE_ENV=production
PORT=8787
LOG_LEVEL=info

# Postgres password for the compose stack. Generate once:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The issuer, as it appears in every token and in OIDC discovery. Relying
# parties (Convex) resolve JWKS from here, so it must be the public HTTPS URL.
ISSUER_URL=https://id.estiva.app

# WebAuthn relying party.
#
# RP_ID is the REGISTRABLE DOMAIN, not the service host. WebAuthn permits an RP
# ID that is a registrable-domain suffix of the origin, and the wider value means
# passkeys survive this service ever moving to another subdomain. Pinning
# `id.estiva.app` would kill every enrolled credential on such a move, with no
# migration path.
RP_ID=estiva.app
RP_NAME="Estiva ID"

# Keep this narrow. RP_ID decides which credentials an authenticator will offer;
# RP_ORIGINS decides which origins this service accepts an assertion from — and
# that is what stops a compromised sibling subdomain using someone's passkey.
RP_ORIGINS=https://id.estiva.app

# ---------------------------------------------------------------------------
# THE ONE THAT MUST NOT BE LOST
# ---------------------------------------------------------------------------
# Decrypts every user's custodied Nostr key. Generate once, on the box:
#
#   openssl rand -hex 32
#
# Then record it somewhere SEPARATE from the database backups, immediately —
# before the first user registers.
#
#   * Lose it  → every identity is unrecoverable ciphertext. There is no
#                recovery path, and everyone's relay history stays signed by
#                keys nobody can ever use again.
#   * Leak it alongside a database dump → the holder can sign as anyone.
#
# Those two failure modes are why the KEK and the dumps must not live in the
# same place. See PEEK-63.
KEY_ENCRYPTION_KEK=
KEY_ENCRYPTION_KID=prod-1

SESSION_MAX_SECONDS=1209600
SESSION_IDLE_SECONDS=604800

# Short by design: Peek validates tokens statelessly against JWKS and never asks
# whether someone is still employed, so this is how long a leaver keeps their
# session after being offboarded.
JWT_TTL_SECONDS=3600

# Empty means REFUSE ALL kind 27235 signing, which is correct until the relay
# bridge is live. Then narrow to its actual paths — not the whole origin.
SIGN_NIP98_ALLOWED_URL_PREFIXES=

# Relays a NIP-42 (kind 22242) challenge response may be signed for. Empty means
# REFUSE ALL 22242, which is correct until an app actually opens a socket.
#
# In production this is the relay's WebSocket origin: wss://estiva.estiva.app
# Matched exactly after normalization, so the whole URL — not a path prefix.
SIGN_RELAY_AUTH_ALLOWED_URLS=
