{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // rootDir lives in tsconfig.build.json, not here: this config also covers
    // `scripts/`, which sits outside src and is typechecked but never emitted.
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // `scripts/` is typechecked but not built — those files handle key material
  // and a duplicate identifier in one of them went unnoticed precisely because
  // they were outside this list. `tsconfig.build.json` excludes them from dist.
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
